{
	"user": "user",
	"repo": "mtb3-demo",
	"tag": "0.0.1",
	"entry": "gamemodes/mtb3-base.pwn",
	"output": "gamemodes/mtb3-base.amx",
	"dependencies": [
		"openmultiplayer/omp-stdlib",
		"pawn-lang/samp-stdlib@open.mp",
		"pawn-lang/pawn-stdlib@open.mp",
		"Pottus/ColAndreas",
		"samp-incognito/samp-streamer-plugin",
		"Mac-Andreas/omp-cmd",
		"wg1337/omp-foreach",
		"Y-Less/sscanf",
		"Southclaws/samp-logger",
		"wg1337/omp-progress2",
		"Zeex/samp-plugin-crashdetect"
	],
	"local": true,
	"builds": [
		{
			"args": [
				"-;+",
				"-(+",
				"-\\+",
				"-d3",
				"-Z+"
			],
			"name": "mtb3-base",
			"includes": ["legacy"]
		}
	],
	"runtime": {
		"mode": "server",
		"version": "openmp",
		"plugins": [
			"crashdetect",
			"streamer",
			"ColAndreas_static"
		],
		"port": 7777,
		"filterscripts": [
			"mapfix"
		]
	}
}
